# ============================================================
# Complete Off Page SEO - environment configuration
# Copy to .env and fill in REAL credentials. The engine NEVER
# fabricates data; without a key the related feature reports
# "unavailable" rather than inventing numbers.
# ============================================================

DATABASE_URL=sqlite:///./offpage_seo.db
SECRET_KEY=change-me-in-production
REDIS_URL=redis://localhost:6379/0

# ---- Google APIs -----------------------------------------------------------
# GOOGLE_API_KEY enables Knowledge Graph lookups.
# GOOGLE_CSE_ID + GOOGLE_API_KEY enables real Google Search (Programmable Search Engine).
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Path to a GSC service-account JSON file (Search Console API).
GSC_CREDENTIALS_FILE=
GA4_PROPERTY_ID=

# ---- SEO Tool APIs ----------------------------------------------------------
# Real paid APIs for backlinks / domain authority / trust metrics.
AHREFS_API_KEY=
MAJESTIC_API_KEY=
MOZ_ACCESS_KEY=
MOZ_SECRET_KEY=

# ---- AI APIs -----------------------------------------------------------------
# Used for RAG/consensus monitoring, sentiment reasoning, pitch generation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SERPAPI_KEY=
PERPLEXITY_API_KEY=

# ---- Search reliability (paid fallbacks before free scraping) -------------------
# Brave Search API ($5/1k, generous free) + Bing Web Search API. Disk cache 7-day TTL.
BRAVE_SEARCH_API_KEY=
BING_SEARCH_API_KEY=

# ---- Security ------------------------------------------------------------------
# Comma-separated allowed origins (production). "*" = local dev.
FRONTEND_ORIGINS=*
# Fernet key for encrypted credential vault. REQUIRED in production when SECRET_KEY is still default
# — vault writes (data/credentials.vault) will fail without it. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_FERNET_KEY=
# REQUIRE_AUTH=true enforces JWT Bearer on write endpoints (python-jose).
REQUIRE_AUTH=false
# When SECRET_KEY is still default (change-me-in-production), POST /api/v1/billing/tenant is BLOCKED
# and credential vault writes are refused — set a strong SECRET_KEY (16+ chars) in production.
# Search chain (visible in startup logs + /api/v1/provider-status):
#   SerpAPI (keyed) -> 7-day disk cache -> Brave API (keyed) -> Bing Web API (keyed) -> Bing RSS (free) -> ddgs (free)
#   DDG HTML leg removed v2026.2; llms.txt scored for ChatGPT/Perplexity/Claude only (Google does NOT use llms.txt).

# ---- Postgres option (multi-brand parallel at scale) ---------------------------
# DATABASE_URL=postgresql+psycopg2://offpage:offpage@localhost:5432/offpage

# ---- CDN / Edge ---------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
FASTLY_API_TOKEN=

# ---- Social & News -------------------------------------------------------------
NEWS_API_KEY=
TWITTER_BEARER_TOKEN=

# ---- Behaviour -----------------------------------------------------------------
# Risk Level: enterprise_safe | aggressive
RISK_TOLERANCE_LEVEL=enterprise_safe

# Crawl Settings
MAX_CONCURRENT_CRAWLS=10
CRAWL_DELAY_SECONDS=1.0
PROXY_URL=

# Whisper / transcript pipeline
# Transcript-first pipeline uses faster-whisper when available. Set to large-v3-turbo
# for best accuracy (requires pip install -r requirements-ml.txt, ~3GB).
# Lean installs use base. Also install youtube-transcript-api for YouTube captions.
WHISPER_MODEL_SIZE=large-v3-turbo

# ---- Data integrity ------------------------------------------------------------
# When true, all search results are live-verified for brand relevance before use.
VERIFY_SEARCH_RESULTS=true
# Minimum relevance score (0-1) a result needs to be treated as a real citation.
MIN_RELEVANCE_SCORE=0.35
REQUEST_TIMEOUT_SECONDS=30
MAX_BACKLINK_REQUESTS=100
